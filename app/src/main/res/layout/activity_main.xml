<?xml version="1.0" encoding="utf-8"?>
<!-- Root: the whole page scrolls when the history panel is open. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scroll_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/bg_screen"
        android:padding="16dp">

    <!-- Header: title, theme toggle and history toggle. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_header"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.12"
            android:text="CALCULATOR"
            android:textColor="@color/btn_operator_bg"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btn_theme"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:contentDescription="Toggle dark mode"
            android:minWidth="76dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="Dark"
            android:textAllCaps="false"
            android:textColor="@color/btn_util_text"
            android:textSize="14sp"
            app:backgroundTint="@color/btn_util_bg"
            app:cornerRadius="14dp" />

        <Button
            android:id="@+id/btn_history"
            android:layout_width="wrap_content"
            android:layout_height="42dp"
            android:minWidth="88dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="History"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@color/btn_operator_text"
            app:backgroundTint="@color/btn_operator_bg"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <!-- Display: dark surface with light text, bottom-right aligned. -->
    <TextView
        android:id="@+id/tv_display"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_display"
        android:fontFamily="sans-serif-medium"
        android:gravity="end|bottom"
        android:maxLines="2"
        android:ellipsize="start"
        android:text="0"
        android:textColor="@color/text_display"
        android:textSize="46sp" />

    <!-- Scientific row: sqrt, square, power and percent. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:layout_marginBottom="6dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_sqrt"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="√"
            android:textAllCaps="false"
            android:textColor="@color/btn_util_text"
            android:textSize="20sp"
            app:backgroundTint="@color/btn_util_bg"
            app:cornerRadius="14dp" />
        <Button
            android:id="@+id/btn_square"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="x²"
            android:textAllCaps="false"
            android:textColor="@color/btn_util_text"
            android:textSize="20sp"
            app:backgroundTint="@color/btn_util_bg"
            app:cornerRadius="14dp" />
        <Button
            android:id="@+id/btn_power"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:text="x^y"
            android:textAllCaps="false"
            android:textColor="@color/btn_util_text"
            android:textSize="16sp"
            app:backgroundTint="@color/btn_util_bg"
            app:cornerRadius="14dp" />
        <Button
            android:id="@+id/btn_percent"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="%"
            android:textAllCaps="false"
            android:textColor="@color/btn_util_text"
            android:textSize="20sp"
            app:backgroundTint="@color/btn_util_bg"
            app:cornerRadius="14dp" />
    </LinearLayout>

    <!-- Keypad: 4-column grid, operators stacked on the right (iOS style). -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:alignmentMode="alignMargins"
        android:columnCount="4">

        <!-- Row 1: C ( ) ÷ -->
        <Button
            android:id="@+id/btn_clear"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_util_bg"
            app:cornerRadius="20dp"
            android:text="C"
            android:textColor="@color/btn_util_text"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btn_lparen"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_util_bg"
            app:cornerRadius="20dp"
            android:text="("
            android:textColor="@color/btn_util_text"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btn_rparen"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_util_bg"
            app:cornerRadius="20dp"
            android:text=")"
            android:textColor="@color/btn_util_text"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btn_div"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_operator_bg"
            app:cornerRadius="20dp"
            android:text="÷"
            android:textColor="@color/btn_operator_text"
            android:textSize="24sp" />

        <!-- Row 2: 7 8 9 × -->
        <Button
            android:id="@+id/btn_7"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_digit_bg"
            app:cornerRadius="20dp"
            android:text="7"
            android:textColor="@color/btn_digit_text"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btn_8"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_digit_bg"
            app:cornerRadius="20dp"
            android:text="8"
            android:textColor="@color/btn_digit_text"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btn_9"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_digit_bg"
            app:cornerRadius="20dp"
            android:text="9"
            android:textColor="@color/btn_digit_text"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btn_mul"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_operator_bg"
            app:cornerRadius="20dp"
            android:text="×"
            android:textColor="@color/btn_operator_text"
            android:textSize="24sp" />

        <!-- Row 3: 4 5 6 − -->
        <Button
            android:id="@+id/btn_4"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_digit_bg"
            app:cornerRadius="20dp"
            android:text="4"
            android:textColor="@color/btn_digit_text"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btn_5"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_digit_bg"
            app:cornerRadius="20dp"
            android:text="5"
            android:textColor="@color/btn_digit_text"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btn_6"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_digit_bg"
            app:cornerRadius="20dp"
            android:text="6"
            android:textColor="@color/btn_digit_text"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btn_sub"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_operator_bg"
            app:cornerRadius="20dp"
            android:text="-"
            android:textColor="@color/btn_operator_text"
            android:textSize="24sp" />

        <!-- Row 4: 1 2 3 + -->
        <Button
            android:id="@+id/btn_1"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_digit_bg"
            app:cornerRadius="20dp"
            android:text="1"
            android:textColor="@color/btn_digit_text"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btn_2"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_digit_bg"
            app:cornerRadius="20dp"
            android:text="2"
            android:textColor="@color/btn_digit_text"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btn_3"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_digit_bg"
            app:cornerRadius="20dp"
            android:text="3"
            android:textColor="@color/btn_digit_text"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btn_add"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_operator_bg"
            app:cornerRadius="20dp"
            android:text="+"
            android:textColor="@color/btn_operator_text"
            android:textSize="24sp" />

        <!-- Row 5: . 0 ⌫ = -->
        <Button
            android:id="@+id/btn_dot"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_digit_bg"
            app:cornerRadius="20dp"
            android:text="."
            android:textColor="@color/btn_digit_text"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btn_0"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_digit_bg"
            app:cornerRadius="20dp"
            android:text="0"
            android:textColor="@color/btn_digit_text"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btn_backspace"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_util_bg"
            app:cornerRadius="20dp"
            android:text="⌫"
            android:textColor="@color/btn_util_text"
            android:textSize="24sp" />
        <Button
            android:id="@+id/btn_eq"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            app:backgroundTint="@color/btn_operator_bg"
            app:cornerRadius="20dp"
            android:text="="
            android:textColor="@color/btn_operator_text"
            android:textSize="24sp" />

    </GridLayout>

    <!-- History panel: populated from the database at runtime. -->
    <LinearLayout
        android:id="@+id/history_panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_history"
        android:elevation="2dp"
        android:orientation="vertical"
        android:padding="12dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="History"
                android:textColor="@color/btn_digit_text"
                android:textSize="18sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btn_clear_history"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Clear"
                android:textAllCaps="false"
                android:textColor="@color/btn_util_text"
                app:backgroundTint="@color/btn_util_bg"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/history_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>
</ScrollView>
